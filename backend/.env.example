# Server Environment
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecotrace_db?schema=public"

# Redis Cache & Rate Limiting
REDIS_URL="redis://localhost:6379"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="ecotrace_dev_jwt_access_secret_key_minimum_32_chars"
JWT_REFRESH_SECRET="ecotrace_dev_jwt_refresh_secret_key_minimum_32_chars"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# CORS Configuration
CORS_ORIGIN="http://localhost:3000"

# Payment Gateway (Razorpay Sandbox)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="placeholder_secret"

# Google Gemini Vision API Key
GEMINI_API_KEY=""

# Cloudinary Evidence Storage (Optional)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
